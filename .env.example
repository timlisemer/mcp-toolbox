# MCP Toolbox Configuration

# Blender MCP connects from the toolbox container to the Blender add-on.
BLENDER_HOST=host.docker.internal
BLENDER_PORT=9876

# Gitea MCP credentials. Use your own instance and access token.
GITEA_HOST=https://gitea.example.com
GITEA_ACCESS_TOKEN=
# Existing Home Assistant MCP endpoint credentials (include the Bearer prefix).
HOMEASSISTANT_AUTHORIZATION=Bearer <long-lived-access-token>
