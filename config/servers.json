{
  "tools": {
    "mcp-nixos": {
      "enabled": true,
      "type": "python",
      "description": "NixOS package and configuration search MCP server",
      "repository": "https://github.com/utensils/mcp-nixos",
      "build_command": "pip3 install -e .",
      "binary_path": "python3 -m mcp_nixos.server",
      "install_path": "python3 -m mcp_nixos.server",
      "capabilities": ["nixos", "packages", "search", "configuration"],
      "default_args": [],
      "environment": {
        "ELASTICSEARCH_URL": "https://search.nixos.org/backend"
      }
    },
    "tailwind-svelte-assistant": {
      "enabled": true,
      "type": "node",
      "description": "Tailwind CSS and SvelteKit documentation and code snippets MCP server",
      "repository": "https://github.com/CaullenOmdahl/Tailwind-Svelte-Assistant",
      "build_command": "npm ci --ignore-scripts && npx tsc",
      "patches": ["tailwind-svelte-assistant-current-mcp-sdk.patch"],
      "binary_path": "run.mjs",
      "install_path": "",
      "capabilities": [
        "svelte",
        "tailwind",
        "documentation",
        "snippets",
        "components"
      ],
      "default_args": [],
      "environment": {
        "NODE_ENV": "production"
      }
    },
    "context7": {
      "enabled": true,
      "type": "node",
      "description": "Up-to-date code documentation for LLMs and AI code editors",
      "repository": "",
      "build_command": "npm install -g @upstash/context7-mcp",
      "binary_path": "npx",
      "install_path": "npx",
      "capabilities": [
        "documentation",
        "code-examples",
        "real-time",
        "version-specific"
      ],
      "default_args": ["-y", "@upstash/context7-mcp"],
      "environment": {
        "NODE_ENV": "production"
      }
    },
    "playwright": {
      "enabled": true,
      "type": "system",
      "description": "Browser automation and page inspection using Playwright",
      "repository": "",
      "build_command": "",
      "binary_path": "/run/current-system/sw/bin/playwright-mcp",
      "install_path": "/run/current-system/sw/bin/playwright-mcp",
      "capabilities": [
        "browser-automation",
        "accessibility",
        "testing",
        "screenshots"
      ],
      "default_args": [
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox"
      ],
      "environment": {
        "NODE_ENV": "production"
      }
    },
    "figma": {
      "enabled": true,
      "type": "remote",
      "description": "Official Figma design context and code generation MCP server",
      "repository": "https://github.com/figma/mcp-server-guide",
      "build_command": "",
      "binary_path": "",
      "install_path": "",
      "transport": "http",
      "url": "https://mcp.figma.com/mcp",
      "capabilities": [
        "design-context",
        "code-generation",
        "design-systems",
        "assets"
      ],
      "default_args": [],
      "environment": {}
    },
    "blender": {
      "enabled": true,
      "type": "python",
      "description": "Blender scene creation, inspection, rendering, and asset integration",
      "repository": "https://github.com/wk1995/blender-mcp",
      "revision": "be4428ef4ed3bbc3cd83b6680dc0202ec84d13ea",
      "build_command": "pip3 install -e .",
      "patches": ["blender-mcp-lazy-connect.patch"],
      "binary_path": "venv/bin/blender-mcp",
      "install_path": "venv/bin/blender-mcp",
      "capabilities": [
        "3d-modeling",
        "scene-inspection",
        "rendering",
        "assets"
      ],
      "default_args": [],
      "environment": {
        "BLENDER_HOST": "host.docker.internal",
        "BLENDER_PORT": "9876"
      }
    },
    "astral-ai": {
      "enabled": true,
      "type": "rust",
      "description": "Native agent workflows for checking, planning, implementation, review, and Git operations",
      "repository": "https://github.com/timlisemer/agent-framework-rs",
      "private_repository": true,
      "revision": "2bfd7f988d730886996aecb73b2c1f9f39ccc44d",
      "build_command": "CARGO_INCREMENTAL=0 cargo run --release --locked --package workspace-quality -- generate && CARGO_INCREMENTAL=0 cargo build --release --locked --package astral-ai-service --package astral-ai-mcp --bins && mkdir -p bin && install -m 755 \"$CARGO_TARGET_DIR/release/astral-ai\" bin/astral-ai && install -m 755 \"$CARGO_TARGET_DIR/release/astral-ai-mcp\" bin/astral-ai-mcp && install -m 755 \"$CARGO_TARGET_DIR/release/astral-ai-tool-policy-hook\" bin/astral-ai-tool-policy-hook && test -s bridge/astral-ai-paths.json && rm -rf .git crates Cargo.lock Cargo.toml justfile",
      "binary_path": "bin/astral-ai-mcp",
      "install_path": "bin/astral-ai-mcp",
      "capabilities": [
        "code-quality",
        "planning",
        "implementation",
        "code-review",
        "git-operations"
      ],
      "default_args": [],
      "environment": {
        "ASTRAL_AI_SOCKET": "/var/lib/astral-ai/data/service.sock",
        "ASTRAL_AI_TOKEN_FILE": "/var/lib/astral-ai/data/token"
      }
    }
  }
}
